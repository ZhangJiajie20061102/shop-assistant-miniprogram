/* app.wxss - 强制生效版 */
page {
  background: #ffffff !important;
  min-height: 100vh;
}

.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
  padding: 40rpx 30rpx;
  background: transparent !important;
}

button {
  background: initial;
}

button:focus {
  outline: 0;
}

button::after {
  border: none;
}
.container {
  padding: 40rpx;
}

.title {
  font-size: 44rpx;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 50rpx;
}

.input {
  height: 90rpx;
  background: #ffffff;
  border: 1px solid #ddd;
  border-radius: 12rpx;
  padding: 0 25rpx;
  margin-bottom: 30rpx;
  box-sizing: border-box;
  font-size: 28rpx;
}

.stock-tip {
  font-size: 24rpx;
  color: #b0b0c0;
  margin-bottom: 30rpx;
}

.save-btn {
  margin-top: 10rpx;
  color: #ffffff;
  background: #2b6cff;
  border-radius: 12rpx;
}

.save-btn[disabled] {
  opacity: 0.6;
}

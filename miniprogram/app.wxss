/* app.wxss - 商务沉稳风（全局生效） */
page {
  min-height: 100vh;
  background: #1a1a2e;
}

.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
  padding: 40rpx 30rpx;
  min-height: 100vh;
  background: linear-gradient(145deg, #1a1a2e 0%, #16213e 40%, #0f3460 100%);
}

button {
  background: initial;
}

button:focus {
  outline: 0;
}

button::after {
  border: none;
}